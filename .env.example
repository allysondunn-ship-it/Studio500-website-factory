# Copy this file to `.env` for local development, or add these values in
# Cloudflare Pages → your project → Settings → Environment variables.
# Never commit real values to Git.

# Public URL of the live website (used for SEO, canonical links and sitemap).
SITE_URL=https://studio500.example

# Where the contact form sends submissions. Leave empty until you've chosen a
# form service. Works with Formspree, Basin, Getform and similar services that
# accept a JSON POST. Example: https://formspree.io/f/abcd1234
PUBLIC_FORM_ENDPOINT=

# Content source: "local" (default — content lives in src/content) or "storyblok".
CMS_PROVIDER=local

# Storyblok (only needed when CMS_PROVIDER=storyblok). Use a *preview* token for
# draft previews and a *public* token for production builds.
STORYBLOK_TOKEN=
# "published" for production builds, "draft" for preview builds.
STORYBLOK_VERSION=published
# Storyblok region: eu (default), us, ap, ca or cn.
STORYBLOK_REGION=eu
