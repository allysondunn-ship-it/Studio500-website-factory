---
/**
 * Renders a content image, or — when no image has been supplied yet — a
 * clearly labelled abstract placeholder drawn in the site's theme colours.
 * Placeholders are inline SVG, so they cost no extra network requests.
 */
import type { ImageRef } from '@/schema/site';

interface Props {
  image: ImageRef;
  class?: string;
  /** CSS aspect ratio, e.g. "4/3". */
  ratio?: string;
  eager?: boolean;
  sizes?: string;
}
const { image, class: className = '', ratio = '4/3', eager = false } = Astro.props;

// Deterministic "random" composition so each placeholder looks distinct but stable.
let seed = 0;
for (const ch of (image.placeholder ?? image.alt)) seed = (seed * 31 + ch.charCodeAt(0)) >>> 0;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) >>> 0;
  return seed / 2 ** 32;
};
const cx = 20 + rand() * 60;
const cy = 25 + rand() * 50;
const r = 22 + rand() * 18;
const bx = rand() * 50;
const rot = Math.round(rand() * 40 - 20);
const uid = `ph${Math.round(rand() * 1e9)}`;
---

{
  image.src ? (
    <img
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      class:list={['h-full w-full object-cover', className]}
      style={`aspect-ratio:${ratio}`}
    />
  ) : (
    <div
      role="img"
      aria-label={`Placeholder image: ${image.alt}`}
      class:list={['relative overflow-hidden bg-muted', className]}
      style={`aspect-ratio:${ratio}`}
    >
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id={`${uid}a`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--raw-accent)" stop-opacity=".85" />
            <stop offset="1" stop-color="var(--raw-accent)" stop-opacity=".25" />
          </linearGradient>
          <linearGradient id={`${uid}b`} x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="var(--raw-inverse)" stop-opacity=".9" />
            <stop offset="1" stop-color="var(--raw-inverse)" stop-opacity=".55" />
          </linearGradient>
        </defs>
        <rect width="100" height="100" fill="var(--raw-muted)" />
        <rect x={bx} y="58" width="70" height="60" fill={`url(#${uid}b)`} transform={`rotate(${rot} 50 80)`} />
        <circle cx={cx} cy={cy} r={r} fill={`url(#${uid}a)`} />
        <path d="M0 78 Q 30 66 55 74 T 100 70 V100 H0Z" fill="var(--raw-surface)" opacity=".55" />
      </svg>
      <span class="absolute top-3 left-3 rounded-full bg-[color-mix(in_oklab,var(--raw-surface)_88%,transparent)] px-3 py-1 text-[0.7rem] font-medium tracking-wide text-[var(--raw-ink)] backdrop-blur-sm">
        Placeholder{image.placeholder ? ` · ${image.placeholder}` : ''}
      </span>
    </div>
  )
}
