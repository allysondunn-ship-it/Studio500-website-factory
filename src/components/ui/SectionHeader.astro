---
interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  intro?: string;
  align?: 'left' | 'center' | 'split';
}
const { id, eyebrow, heading, intro, align = 'left' } = Astro.props;
---

{
  (eyebrow || heading || intro) && (
    <header
      class:list={[
        'reveal mb-12 md:mb-16',
        align === 'center' && 'mx-auto max-w-3xl text-center',
        align === 'split' && 'grid gap-6 md:grid-cols-12 md:items-end',
        align === 'left' && 'max-w-3xl',
      ]}
    >
      <div class:list={[align === 'split' && 'md:col-span-7']}>
        {eyebrow && <p class:list={['eyebrow mb-5', align === 'center' && 'justify-center']}>{eyebrow}</p>}
        {heading && (
          <h2 id={id} class="text-[2.1rem] leading-[1.08] font-normal sm:text-5xl md:text-[3.4rem]">
            {heading}
          </h2>
        )}
      </div>
      {intro && (
        <p
          class:list={[
            'text-lg leading-relaxed text-ink-soft',
            align === 'split' ? 'md:col-span-5 md:pb-2' : 'mt-5',
          ]}
        >
          {intro}
        </p>
      )}
    </header>
  )
}
