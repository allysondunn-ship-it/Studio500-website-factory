---
import type { Site } from '@/schema/site';
import Wordmark from './Wordmark.astro';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="tone-inverse overflow-hidden bg-bg pt-20 text-ink md:pt-28">
  <div class="container-site">
    <div class="grid gap-12 border-b border-line pb-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <Wordmark name={site.business.name} />
        {site.footer.blurb && <p class="mt-5 max-w-sm leading-relaxed text-ink-soft">{site.footer.blurb}</p>}
        <ul class="mt-6 space-y-1.5 text-ink-soft">
          {site.business.email && <li><a href={`mailto:${site.business.email}`} class="hover:text-ink">{site.business.email}</a></li>}
          {site.business.phone && <li><a href={`tel:${site.business.phone.replace(/[^\d+]/g, '')}`} class="hover:text-ink">{site.business.phone}</a></li>}
          {site.business.address && <li>{site.business.address}</li>}
        </ul>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
        {
          site.footer.columns.map((col) => (
            <nav aria-label={col.heading}>
              <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{col.heading}</h2>
              <ul class="mt-5 space-y-3">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="text-ink/85 transition hover:text-ink">{l.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>
    <div class="flex flex-col gap-3 py-8 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.business.name}. {site.footer.legal}</p>
      <a href="#top" class="hover:text-ink">Back to top ↑</a>
    </div>
  </div>
  <div aria-hidden="true" data-decorative class="container-site -mb-[3vw] select-none opacity-[0.07]">
    <Wordmark name={site.business.name} size="xl" />
  </div>
</footer>
