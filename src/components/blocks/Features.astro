---
import type { BlockOf } from '@/schema/site';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  block: BlockOf<'features'>;
}
const { block } = Astro.props;
const hid = block.id ? `${block.id}-title` : undefined;
const cols = { 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-2 lg:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[block.columns];
---

<Section id={block.id} tone={block.tone} labelledBy={hid}>
  <div class="container-site">
    <SectionHeader id={hid} eyebrow={block.eyebrow} heading={block.heading} intro={block.intro} />
    <ul class:list={['grid gap-x-10 gap-y-12', cols]}>
      {
        block.items.map((item, i) => (
          <li class="reveal border-t border-line pt-7" style={`transition-delay:${(i % 3) * 80}ms`}>
            {item.icon && (
              <span class="mb-6 grid size-11 place-items-center rounded-ui bg-surface text-accent-text ring-1 ring-line">
                <Icon name={item.icon} size={21} />
              </span>
            )}
            <h3 class="font-sans text-lg font-semibold tracking-[-0.01em]">{item.title}</h3>
            <p class="mt-2.5 leading-relaxed text-ink-soft">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
