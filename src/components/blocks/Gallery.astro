---
import type { BlockOf } from '@/schema/site';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';

interface Props {
  block: BlockOf<'gallery'>;
}
const { block } = Astro.props;
const hid = block.id ? `${block.id}-title` : undefined;
---

<Section id={block.id} tone={block.tone} labelledBy={hid}>
  <div class="container-site">
    <SectionHeader id={hid} eyebrow={block.eyebrow} heading={block.heading} intro={block.intro} />
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
      {
        block.items.map((item) => (
          <li class="reveal">
            <figure class="h-full">
              <Picture image={item.image} ratio="4/5" class="rounded-card" />
              {item.caption && <figcaption class="mt-3 text-sm text-ink-soft">{item.caption}</figcaption>}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
