---
import type { BlockOf } from '@/schema/site';
import Section from '../ui/Section.astro';

interface Props {
  block: BlockOf<'text'>;
}
const { block } = Astro.props;
const hid = block.id ? `${block.id}-title` : 'text-title';
---

<Section id={block.id} tone={block.tone} labelledBy={hid}>
  <div class="container-site">
    <article class="mx-auto max-w-2xl">
      {block.eyebrow && <p class="eyebrow mb-5">{block.eyebrow}</p>}
      <h1 id={hid} class="text-4xl leading-[1.05] md:text-6xl">{block.heading}</h1>
      {block.intro && <p class="mt-6 text-lg leading-relaxed text-ink-soft">{block.intro}</p>}
      {
        block.parts.map((part) => (
          <div class="mt-10">
            {part.heading && <h2 class="text-2xl">{part.heading}</h2>}
            {part.paragraphs.map((p) => <p class="mt-4 leading-relaxed text-ink-soft">{p}</p>)}
          </div>
        ))
      }
    </article>
  </div>
</Section>
